err-gfx-model-no-json = मशीन मॉडल फ़ाइल में विवरण खंड नहीं है
err-gfx-model-read = { $model } मशीन मॉडल पढ़ा नहीं जा सका
err-gfx-model-float-vectors = मशीन मॉडल का वेक्टर फ़ॉर्मैट असमर्थित है
err-gfx-model-scalar-indices = मशीन मॉडल का इंडेक्स फ़ॉर्मैट असमर्थित है
err-gfx-model-embedded = मशीन मॉडल को अपना डेटा फ़ाइल में ही रखना होगा
err-gfx-model-component = मशीन मॉडल असमर्थित डेटा प्रकार ({ $kind }) उपयोग करता है
err-gfx-model-not-glb = मशीन मॉडल बाइनरी glTF फ़ाइल नहीं है
err-gfx-model-version = मशीन मॉडल glTF संस्करण { $version } उपयोग करता है, 2 नहीं
err-gfx-model-accessor-range = मशीन मॉडल का डेटा उसके बफ़र के बाहर है
err-gfx-model-too-deep = मशीन मॉडल में बहुत अधिक नेस्टेड हिस्से हैं
err-gfx-model-index-range = मशीन मॉडल में एक फलक अपने शीर्षों के पार इशारा करता है
err-gfx-model-empty = मशीन मॉडल में कोई फलक नहीं है
err-memory-estimate-overflows = { $what } का मेमोरी अनुमान बहुत बड़ा है
err-memory-over-budget = { $what } को { $needed } MiB चाहिए, पर ब्राउज़र की 3 GiB कार्य मेमोरी में केवल { $remaining } MiB बची है
err-memory-what-block-model = ब्लॉक मॉडल
err-memory-what-block-volume = ब्लॉक मॉडल आयतन दृश्य
err-cloud-too-many-to-classify = पॉइंट क्लाउड में एक बार में वर्गीकृत करने के लिए बहुत अधिक पॉइंट हैं
err-solids-invalid-block-bounds = एक ब्लॉक की सीमाएँ अमान्य हैं
err-solids-invalid-block-transform = एक ब्लॉक की स्थिति या स्केल अमान्य है
err-solids-flitch-no-footprint = RL { $rl } की फ्लिच का कोई मान्य डिग ब्लॉक रूपरेखा नहीं है
video-filter-mp4 = MP4 वीडियो (AV1)
video-filter-mov = QuickTime मूवी (AV1)
video-filter-webm = WebM वीडियो (AV1)
video-filter-gif = GIF एनिमेशन
err-file-desc-video = वीडियो
err-file-desc-project = प्रोजेक्ट
